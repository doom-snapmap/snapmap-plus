# Build artifacts -- the source is the deliverable; the DLLs are rebuilt via build.ps1, and the
# deployable overlay bundle is assembled into dist/ by package.ps1.
build/
dist/
*.obj
*.dll
*.exe
*.lib
*.exp
*.pdb
*.ilk
*.cod
*.log
*.syso

# Keep the shared Claude instructions; ignore all other local agent state.
.claude/*
!.claude/CLAUDE.md
.codex/

# Personal local-dev convenience scripts (not for upstream)
/deploy.ps1

# wrangler's local cache (account metadata -- never commit)
feedback/.wrangler/
community/.wrangler/

# wrangler local-dev secrets (per-machine; never commit)
.dev.vars
deploy.ps1
docs/rawmap-save-load-system.md

# Generated from CHANGELOG.md by pages.yml at build time (tools/changelog.py --json)
site/_data/changelog.json

# Jekyll's local build output (jekyll serve)
site/_site/

# Python bytecode cache (tools/)
__pycache__/
*.pyc

# Written by tools/sync_release_notes.py before it rewrites a published release body
release-bodies-backup.json
