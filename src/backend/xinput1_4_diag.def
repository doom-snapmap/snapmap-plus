; xinput1_4_diag.def -- the diagnostic build's exports (build.ps1 -Diag): xinput1_4.def plus the
; sh_diag_* entries at ordinals 300-303 for the development daemon (diag_status.h). tests/diag_status_test.c
; checks that the two agree.
; XInputGetState and XInputSetState sit at ordinals 2 and 3 because DOOM 2016 (Steam build 13954591)
; imports them from XINPUT1_4.dll by ordinal; MSVC dllexport numbers alphabetically, so xinput_proxy.c
; carries no dllexport. The rest is the Windows 11 System32 ordinal set, with unnamed ordinals as NONAME
; forwarders. Ordinal 1 (DllMain) is not exported.
EXPORTS
    XInputGetState                  @2
    XInputSetState                  @3
    XInputGetCapabilities           @4
    XInputEnable                    @5
    XInputGetBatteryInformation     @7
    XInputGetKeystroke              @8
    XInputGetAudioDeviceIds         @10
    sh_xinput_ordinal_100           @100 NONAME
    sh_xinput_ordinal_101           @101 NONAME
    sh_xinput_ordinal_102           @102 NONAME
    sh_xinput_ordinal_103           @103 NONAME
    sh_xinput_ordinal_104           @104 NONAME
    sh_xinput_ordinal_108           @108 NONAME
    sh_xinput_ordinal_109           @109 NONAME
    sh_diag_status                  @300
    sh_diag_note                    @301
    sh_diag_note_listening          @302 DATA
    sh_diag_hold_entity             @303 DATA
